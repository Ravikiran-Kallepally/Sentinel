# Copy to .env and edit. Every setting has a safe default; with nothing set, Sentinel runs fully offline.

# ---- LLM provider -----------------------------------------------------------------------------
# auto (default): anthropic if ANTHROPIC_API_KEY is set, else openai if OPENAI_API_KEY is set, else offline
LLM_PROVIDER=auto
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL_STRONG=claude-opus-5-5
# ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL_STRONG=gpt-4o
# OPENAI_MODEL_FAST=gpt-4o-mini
# Azure OpenAI (LLM_PROVIDER=azure): uses AZURE_OPENAI_API_KEY + AZURE_OPENAI_ENDPOINT
# AZURE_OPENAI_DEPLOYMENT_STRONG=
# AZURE_OPENAI_DEPLOYMENT_FAST=
# Fall back to the offline provider if the real one keeps failing (true/false)
LLM_FALLBACK_OFFLINE=true

# ---- RAG --------------------------------------------------------------------------------------
EMBEDDING_BACKEND=lsa            # lsa | sentence-transformers (needs a one-time model download)
RAG_QUERY_REWRITE=false          # measured: the rule-based rewrite hurt MRR - re-measure with a real LLM
RAG_CHUNK_TOKENS=220
RAG_RERANK_K=5

# ---- Agent budgets ------------------------------------------------------------------------------
AGENT_MAX_STEPS=8
AGENT_MAX_COST_USD=0.50

# ---- Data simulation ----------------------------------------------------------------------------
SENTINEL_SEED=7
SENTINEL_N_CUSTOMERS=1500
SENTINEL_N_DAYS=120

# ---- API ----------------------------------------------------------------------------------------
# SENTINEL_API_KEY=change-me      # if set, every /api call needs header X-API-Key
